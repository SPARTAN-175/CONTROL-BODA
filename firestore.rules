rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'avengers_0077@hotmail.com';
    }
    match /weddingGuests/{guestCode} {
      allow read: if signedIn();
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (signedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'arrived', 'checkedIn', 'arrivalTime', 'delivered', 'deliveryTime', 'updatedAt', 'updatedBy'
        ])
        && request.resource.data.arrived is number
        && request.resource.data.arrived >= 0
        && request.resource.data.arrived <= resource.data.personas
        && request.resource.data.delivered is bool);
    }
    match /staffProfiles/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.role == 'staff'
        && request.resource.data.email == request.auth.token.email;
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow update, delete: if isAdmin();
    }
  }
}
